generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  QA_LEAD
  AUTOMATION
  VIEWER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum EmulatorStatus {
  DRAFT
  STARTING
  RUNNING
  STOPPING
  STOPPED
  ERROR
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYING
}

enum ResultStatus {
  PASSED
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  testCases   TestCase[]
  cycles      TestCycle[]
  runs        Run[]
}

model TestCase {
  id             String      @id @default(uuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  steps          String      @default("")
  automationRef  String?
  priority       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  stepsList      TestCaseStep[]
  cycleItems     CycleItem[]
  results        TestResult[]
}

model TestCaseStep {
  id          String   @id @default(uuid())
  testCaseId  String
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  action      String
  expected    String?
  testData    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([testCaseId, sortOrder])
}

model TestCycle {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       CycleItem[]
  runs        Run[]
}

model CycleItem {
  id         String    @id @default(uuid())
  cycleId    String
  cycle      TestCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  sortOrder  Int       @default(0)

  @@unique([cycleId, testCaseId])
}

model Device {
  id             String         @id @default(uuid())
  name           String
  tokenLookup    String         @unique
  capabilities   Json           @default("{}")
  status         DeviceStatus   @default(OFFLINE)
  lastHeartbeat  DateTime?
  apiTokenHash   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  executionJobs  ExecutionJob[]
  testResults    TestResult[]
}

/// Android emulator / docker-android instance tracked for operators (noVNC + Appium URLs).
model EmulatorInstance {
  id               String          @id @default(uuid())
  name             String
  mode             String
  status           EmulatorStatus  @default(DRAFT)
  displayUrl       String?
  appiumUrl        String?
  emulatorDevice   String?
  containerName    String?         @unique
  dockerImage      String?
  errorMessage     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Run {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleId         String
  cycle           TestCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  status          RunStatus      @default(QUEUED)
  idempotencyKey  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  results         TestResult[]
  executionJobs   ExecutionJob[]

  @@unique([projectId, idempotencyKey])
}

model ExecutionJob {
  id            String     @id @default(uuid())
  runId         String
  run           Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status        JobStatus  @default(PENDING)
  attemptCount  Int        @default(0)
  maxRetries    Int        @default(3)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model TestResult {
  id          String       @id @default(uuid())
  runId       String
  run         Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId  String
  testCase    TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  status      ResultStatus
  durationMs  Int?
  logs        String?
  artifactUrls Json?
  createdAt   DateTime     @default(now())

  @@unique([runId, testCaseId, deviceId])
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  resource   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
