# Copy to zeppole.autopilot.env (or run: npm run zeppole:up to generate automatically).
# Do not commit zeppole.autopilot.env — it contains secrets.

JWT_SECRET=replace-with-openssl-rand-hex-32
ZEPPOLE_EMULATOR_BRIDGE_TOKEN=replace-with-openssl-rand-hex-24
ZEPPOLE_ADMIN_EMAIL=admin@zeppole.local
ZEPPOLE_ADMIN_PASSWORD=replace-with-strong-password
ZEPPOLE_PUBLIC_HOST=localhost
ZEPPOLE_PUBLIC_SCHEME=http
